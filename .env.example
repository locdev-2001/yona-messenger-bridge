# Messenger Personal Bridge — env template (local development)
# Copy to .env. Variables already set in the process environment win over this file.

BRIDGE_ENV=local

# Loopback only: the bridge refuses any other address.
BRIDGE_HTTP_HOST=127.0.0.1
BRIDGE_HTTP_PORT=8614
# Base of the /media/{token} links sent to Laravel (default http://BRIDGE_HTTP_HOST:BRIDGE_HTTP_PORT).
# BRIDGE_PUBLIC_URL=http://127.0.0.1:8614

# Webhooks go to {LARAVEL_BASE_URL}/webhooks/messenger-personal with header X-Messenger-Bridge-Secret.
# Prefer 127.0.0.1 over localhost so the request does not try ::1 first.
LARAVEL_BASE_URL=http://127.0.0.1:8610
LARAVEL_WEBHOOK_SECRET=change-me-webhook-secret

# Same values as MESSENGER_BRIDGE_UI_SECRET / MESSENGER_BRIDGE_SEND_SECRET in Laravel's .env.
# Empty secret = every request to that group of endpoints is refused (401).
BRIDGE_UI_SECRET=change-me-ui-secret
BRIDGE_SEND_SECRET=change-me-send-secret

# REQUIRED, 32 random bytes in base64 each. Generate: openssl rand -base64 32
# SESSION_KEY seals session files and the webhook outbox (AES-256-GCM).
# DEVICE_KEY encrypts the whole end-to-end key database (SQLCipher).
# Losing either key = every account must log in again. Never reuse one for the other.
BRIDGE_SESSION_KEY=
BRIDGE_DEVICE_KEY=

# Sessions, device database, outbox and temporary media live here (mode 0700, gitignored).
BRIDGE_STATE_DIR=./state

# Accounts this process serves at most; a new login beyond it gets session_cap_reached (429).
BRIDGE_MAX_SESSIONS=50

# Outbound attachments: media.url is Laravel's Attachment::downloadUrl(), built from APP_URL
# (dev: http://localhost:8610/...). Entries are host[:port] matched exactly as written;
# a bare host accepts any port. Plain http is only accepted for localhost/127.0.0.1.
# The host[:port] of LARAVEL_BASE_URL is always allowed.
BRIDGE_FETCH_HOST_ALLOWLIST=localhost:8610,127.0.0.1:8610
BRIDGE_MAX_MEDIA_BYTES=26214400

# JSON lines go to stdout; set a path to also append them to a file.
# BRIDGE_LOG_FILE=../../storage/logs/messenger-bridge/bridge.log
BRIDGE_LOG_LEVEL=info
# Messenger/encryption library logs (redacted). Keep at warn: lower levels are noisy.
BRIDGE_LIBRARY_LOG_LEVEL=warn
