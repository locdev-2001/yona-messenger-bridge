# Messenger Personal Bridge — production env template
# The bridge refuses to boot in production when a secret or key is missing,
# when LARAVEL_BASE_URL is not https, or when it is asked to listen off loopback.

BRIDGE_ENV=production

BRIDGE_HTTP_HOST=127.0.0.1
BRIDGE_HTTP_PORT=8614

LARAVEL_BASE_URL=https://yona.vn
# Must equal MESSENGER_BRIDGE_WEBHOOK_SECRET in Laravel's .env. Generate: openssl rand -hex 32
LARAVEL_WEBHOOK_SECRET=
# Must equal MESSENGER_BRIDGE_UI_SECRET / MESSENGER_BRIDGE_SEND_SECRET in Laravel's .env.
BRIDGE_UI_SECRET=
BRIDGE_SEND_SECRET=

# 32 random bytes in base64 each (openssl rand -base64 32). Back them up outside the server:
# without them the saved sessions and device keys cannot be read.
BRIDGE_SESSION_KEY=
BRIDGE_DEVICE_KEY=

# Absolute path writable by user www (the repo dir is owned by root). Supervisor runs
# bin/messenger-bridge as www with cwd = services/messenger-bridge/, which is where .env is read from.
BRIDGE_STATE_DIR=/www/wwwroot/yona.vn/storage/messenger-bridge

BRIDGE_MAX_SESSIONS=50

# APP_URL host; https only (plain http is refused off loopback).
BRIDGE_FETCH_HOST_ALLOWLIST=yona.vn
BRIDGE_MAX_MEDIA_BYTES=26214400

# supervisor captures stdout into storage/logs/messenger-bridge/bridge.log; leave BRIDGE_LOG_FILE
# empty there or every line is written twice.
# BRIDGE_LOG_FILE=
BRIDGE_LOG_LEVEL=info
BRIDGE_LIBRARY_LOG_LEVEL=warn
